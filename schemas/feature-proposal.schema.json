{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikolaytashev/ai-first-learning-app/schemas/feature-proposal.schema.json",
  "title": "Feature Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_version",
    "title",
    "problem",
    "target_users",
    "desired_outcome",
    "success_measures",
    "scope",
    "acceptance_criteria",
    "risks",
    "dependencies",
    "decisions_required",
    "priority",
    "size",
    "status",
    "context_refs",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^FP-[0-9]{4,}$"
    },
    "proposal_version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "problem": {
      "type": "string",
      "minLength": 20
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 20
    },
    "success_measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/success_measure"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptance_criterion"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "size": {
      "enum": [
        "XS",
        "S",
        "M",
        "L"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "needs_decision"
      ]
    },
    "context_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_decision"
          }
        }
      },
      "then": {
        "properties": {
          "decisions_required": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "success_measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure",
        "target",
        "measurement_window"
      ],
      "properties": {
        "measure": {
          "type": "string",
          "minLength": 5
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurement_window": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "verification": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "mitigation"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 5
        },
        "mitigation": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "role",
        "agent_version",
        "generated_at"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "product_manager"
        },
        "agent_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
