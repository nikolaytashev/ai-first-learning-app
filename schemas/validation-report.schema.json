{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikolaytashev/ai-first-learning-app/schemas/validation-report.schema.json",
  "title": "Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "workflow_id",
    "issue_number",
    "profile",
    "commit_sha",
    "status",
    "started_at",
    "completed_at",
    "checks",
    "acceptance_criteria_results",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "acceptance_criteria_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion_result"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "status",
        "exit_code",
        "elapsed_ms",
        "summary",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "status",
        "evidence"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^AC-[0-9]+$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
