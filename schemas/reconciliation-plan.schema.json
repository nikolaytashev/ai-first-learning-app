{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikolaytashev/ai-first-learning-app/schemas/reconciliation-plan.schema.json",
  "title": "Project Reconciliation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "parent_issue_number", "parent_type", "approval_impact", "desired_children", "supersede_existing", "summary", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "parent_issue_number": {"type": "integer", "minimum": 1},
    "parent_type": {"enum": ["Epic", "Feature"]},
    "approval_impact": {"enum": ["unchanged", "invalidate", "decision_required", "cancel"]},
    "desired_children": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "existing_issue_number", "title", "description", "acceptance_criteria", "priority", "size", "risk", "classification", "specialists", "dependencies"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "type": {"enum": ["Feature", "Task"]},
          "existing_issue_number": {"type": ["integer", "null"], "minimum": 1},
          "title": {"type": "string", "minLength": 3, "maxLength": 160},
          "description": {"type": "string", "minLength": 3},
          "acceptance_criteria": {
            "type": "array",
            "items": {"type": "string", "minLength": 3}
          },
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "size": {"enum": ["XS", "S", "M", "L"]},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ambiguity", "affected_areas", "security_sensitive", "persistent_data_change", "destructive_migration", "architecture_change", "user_visible_change", "concurrency_sensitive", "data_loss_risk", "previous_failures", "learning_content"],
            "properties": {
              "ambiguity": {"enum": ["low", "medium", "high"]},
              "affected_areas": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "security_sensitive": {"type": "boolean"},
              "persistent_data_change": {"type": "boolean"},
              "destructive_migration": {"type": "boolean"},
              "architecture_change": {"type": "boolean"},
              "user_visible_change": {"type": "boolean"},
              "concurrency_sensitive": {"type": "boolean"},
              "data_loss_risk": {"type": "boolean"},
              "previous_failures": {"type": "integer", "minimum": 0},
              "learning_content": {"type": "boolean"}
            }
          },
          "specialists": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["software_architect", "instructional_designer"]}
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}
          }
        }
      }
    },
    "supersede_existing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_number", "reason"],
        "properties": {
          "issue_number": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    },
    "summary": {"type": "string", "minLength": 3},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agent_version", "generated_at"],
      "properties": {
        "role": {"const": "business_analysis"},
        "agent_version": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
