# Non-secret local overrides. Repository and Project owner remain authoritative in
# config/github.yaml and cannot be overridden from the environment.
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_URL=
GITHUB_AUTOMATION_LOGIN=
# Allowed values: github_app, restricted_bot
GITHUB_AUTOMATION_IDENTITY_TYPE=
ORCHESTRATOR_STATE_DIRECTORY=.orchestrator

# GitHub App runtime authentication. The Client ID is not secret. The PEM private
# key itself must live outside the repository with restrictive filesystem permissions.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional. When omitted, the orchestrator resolves the installation from the repository.
GITHUB_APP_INSTALLATION_ID=

# Optional notification destination. When omitted and provider=auto, notifications
# are emitted as structured JSON to stderr.
ORCHESTRATOR_NOTIFICATION_WEBHOOK_URL=

# GITHUB_TOKEN is intentionally omitted. It is used only by the legacy restricted_bot
# identity mode and must be injected externally. github_app mints and refreshes its own
# short-lived installation tokens from the Client ID and private key.
